# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu_clave_supabase_anon_o_service

# ── Flask ────────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_un_secreto_largo_y_aleatorio
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# ── CORS (separar con comas para multiples origenes) ─────
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── IA ───────────────────────────────────────────────────
GROQ_API_KEY=

# ── Voz de PERSONA (Piper TTS, opcional) ─────────────────
# Ruta al ejecutable de Piper disponible en el servidor.
PIPER_BINARY=piper
# Ruta al modelo .onnx de la voz de la PERSONA.
PIPER_MODEL=
# Opcional: directorio donde se guardan los WAV generados.
# Por defecto: static/audio
PIPER_OUTPUT_DIR=
