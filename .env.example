# ── Supabase ─────────────────────────────────────────────
# URL de tu proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave anon o service de Supabase
SUPABASE_KEY=tu_clave_supabase_anon_o_service

# ── Flask ────────────────────────────────────────────────
# Secreto largo y aleatorio para sesiones (OBLIGATORIO en produccion)
SECRET_KEY=cambia_esto_por_un_secreto_largo_y_aleatorio_minimo_32_caracteres
# Modo de entorno (development | production)
FLASK_ENV=development
# Activar depuracion de Flask (1 para si, 0 para no)
FLASK_DEBUG=1
# Host donde escucha el servidor Flask
FLASK_HOST=127.0.0.1
# Puerto donde escucha el servidor Flask
FLASK_PORT=5000

# ── CORS (separar multiples origenes con comas) ─────────
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── LLM / IA ──────────────────────────────────────────────
# API Key de Groq (OBLIGATORIO para funcionalidad de chat)
GROQ_API_KEY=tu_clave_groq_aqui
# API Key de DeepSeek (opcional - fallback alternativo)
DEEPSEEK_API_KEY=
# API Key de OpenAI (opcional - no recomendado, usa Groq en su lugar)
# OPENAI_API_KEY=
